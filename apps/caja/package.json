  "author": "todoEnLocal <soporte@todoenlocal.com>",
  "private": true,
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:electron\"",
    "dev:web": "cd webapp && vite",
