    "@enlocal/core-license": "workspace:*",
    "@enlocal/core-server": "workspace:*",
    "@enlocal/core-sync": "workspace:*",
    "@enlocal/core-updater": "workspace:*",
    "@enlocal/mod-catalogs": "workspace:*",
    "@enlocal/mod-config": "workspace:*",
    "@enlocal/mod-inventory": "workspace:*",
    "@enlocal/mod-invoicing": "workspace:*",
    "@enlocal/mod-pos": "workspace:*",
    "@enlocal/mod-quotes": "workspace:*",
    "@enlocal/mod-reports": "workspace:*",
    "@enlocal/react-components": "workspace:*",
    "@enlocal/react-hooks": "workspace:*",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.0",
    "lucide-react": "^0.460.0",
    "pg": "^8.13.0",
